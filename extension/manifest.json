{
  "manifest_version": 3,
  "name": "Developer Power Mode Combo",
  "version": "1.0.0",
  "description": "Arcade combo counter, neon typing sparks and pixel-art ambient themes for ordinary web text fields. Local only.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Developer Power Mode Combo",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/core.js", "src/themes.js", "src/audio.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
